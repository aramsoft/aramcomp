<?xml version="1.0" encoding="UTF-8"?>

<Configuration>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d %5p %c{1.} %m%n" />
        </Console>
    </Appenders>

    <Loggers>
<!-- 
	    <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="TRACE" additivity="false">
	        <AppenderRef ref="console" />
	    </logger>
-->
		<!-- log SQL with timing information, post execution -->
        <Logger name="java.sql" level="ERROR" additivity="false">
            <AppenderRef ref="console" />
        </Logger>
	    <logger name="org.springframework" level="INFO" additivity="false">
	        <AppenderRef ref="console" />
	    </logger>
        <Logger name="org.egovframe" level="INFO" additivity="false">
            <AppenderRef ref="console" />
        </Logger>
        
        <Logger name="aramframework" level="DEBUG" additivity="false">
            <AppenderRef ref="console" />
        </Logger>
        
        <Root level="ERROR">
            <AppenderRef ref="console" />
        </Root>
    </Loggers>

</Configuration>
