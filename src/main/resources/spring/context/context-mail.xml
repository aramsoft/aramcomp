    <!-- 메일 연동 인터페이스에서 첨부파일 사용 -->
	<bean id="egovMultiPartEmail" class="aramframework.com.cop.ems.service.EgovMultiPartEmail"> 
		<constructor-arg  name="host" 			value="${mail.host}" />
		<constructor-arg  name="port" 			value="${mail.port}" />
		<constructor-arg  name="mailId" 		value="${mail.id}" />
		<constructor-arg  name="mailPass" 		value="${mail.pass}" />
		<constructor-arg  name="mailName" 		value="${mail.name}" />
		<constructor-arg  name="emailAddress" 	value="${mail.address}" />
	</bean>

</beans> 